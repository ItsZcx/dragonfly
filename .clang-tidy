---
# Enum widths are pinned by the wire format, not by the largest enumerator.
# docs/contracts.md fixes VenueId at uint32_t to match the venue_id field, and
# the enum classes in "Shared vocabulary" each name their underlying type for
# the same reason. Narrowing one to the smallest type that fits its current
# values would change a wire layout to save bytes nobody is spending, and the
# next enumerator added could silently change it again.
#
# This comment is above `Checks:` rather than inside it on purpose. A folded
# scalar joins its lines with spaces and does not treat a `#` as a comment once
# the scalar has started, so an inline comment here would be parsed as part of
# the preceding check name and silently drop that check.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  cppcoreguidelines-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -readability-identifier-length
WarningsAsErrors: ''
# Unanchored on purpose. clang-tidy matches this against the absolute path, so
# an anchored ^(contracts|core|...)/.* would never match
# /Users/you/dragonfly/core/types/... . The pattern is a substring test on the
# path, and it keeps third-party headers out of the report.
HeaderFilterRegex: '(contracts|core|apps|tests|bench)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  # Constants and constexpr variables use Google-style k-prefixed camel case:
  # kMaxBookLevels, kScale. The prefix marks a compile-time value at a glance,
  # which matters on this codebase where a name like MaxLevels could otherwise be
  # a mutable runtime value. Both ConstantPrefix and ConstexprVariablePrefix are
  # required so the check accepts the prefix rather than flagging it.
  - key: readability-identifier-naming.ConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantPrefix
    value: 'k'
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k'
  # Enum values are SCREAMING_CASE only where they are unscoped; the design uses
  # `enum class` throughout, so EnumConstantCase follows the class convention.
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
